
class Main {
    public static void sortTwoColors(int[] nums){
        int n = nums.length;
        int i=0;
        int j=nums.length-1;
        
        while(i<j){
            if(nums[i]==0){
                i=i+1;
            }
            else{
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j]=temp;
                j--;
            }
        }
    }
    public static void main(String[] args) {
        int nums[] = {0,1,1,1,0,0,1,1};
        int n = nums.length;
        System.out.println("Before: ");
        for(int i=0;i<n;i++){
            System.out.print(nums[i]);
        }
        sortTwoColors(nums);
        System.out.println();
        
        System.out.println("After: ");
        for(int i=0;i<n;i++){
            System.out.print(nums[i]);
        }
    }
}
